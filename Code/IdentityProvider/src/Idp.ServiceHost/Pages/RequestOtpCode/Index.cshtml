@page
@model Idp.ServiceHost.Pages.RequestOtpCode.IndexModel
@{
    ViewData["Title"] = "Login";
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Login With Password</h2>
                <p class="text-muted mb-4">Use your phone number and password.</p>

                <form method="post" asp-page-handler="Password">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="PasswordPhoneNumberOrEmail" class="form-label">Phone number or email</label>
                        <input asp-for="PasswordPhoneNumberOrEmail" class="form-control" placeholder="+989123456789 or user@example.com" />
                        <span asp-validation-for="PasswordPhoneNumberOrEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Sign in</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Login With OTP</h2>
                <p class="text-muted mb-4">Receive a one-time code by SMS.</p>

                <form method="post" asp-page-handler="RequestOtp">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OtpPhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="OtpPhoneNumber" class="form-control" placeholder="+989123456789" />
                        <span asp-validation-for="OtpPhoneNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-outline-primary">Send OTP code</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
