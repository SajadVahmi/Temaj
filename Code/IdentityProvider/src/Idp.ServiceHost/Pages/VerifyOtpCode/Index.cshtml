@page
@model Idp.ServiceHost.Pages.VerifyOtpCode.VerifyOtpCodeModel
@{
    ViewData["Title"] = "Verify OTP";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h1 class="h5">Verify OTP Code</h1>
                <p class="text-muted">Code sent to <strong>@Model.PhoneNumber</strong></p>

                <form method="post">
                    <input type="hidden" asp-for="PhoneNumber" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label">OTP code</label>
                        <input asp-for="OtpCode" class="form-control" autocomplete="one-time-code" />
                        <span asp-validation-for="OtpCode" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Verify and sign in</button>
                    <a asp-page="/RequestOtpCode/Index" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-link">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
