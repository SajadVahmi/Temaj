@page
@model Idp.ServiceHost.Pages.VerifyAuthenticatorCode.IndexModel
@{
    ViewData["Title"] = "Verify Authenticator Code";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h1 class="h5">Two-Factor Authentication</h1>
                <p class="text-muted">Enter the verification code from your authenticator app.</p>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="VerificationCode" class="form-label">Authenticator code</label>
                        <input asp-for="VerificationCode" class="form-control" autocomplete="one-time-code" />
                        <span asp-validation-for="VerificationCode" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMachine" class="form-check-input" />
                        <label asp-for="RememberMachine" class="form-check-label">Remember this device</label>
                    </div>

                    <button type="submit" class="btn btn-primary">Verify and sign in</button>
                    <a asp-page="/RequestOtpCode/Index" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-link">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
